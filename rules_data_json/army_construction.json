{
  "domain": "army_construction",
  "sourceRef": {
    "file": "rulebooks/chapters/02_wargame/04_army_construction.md",
    "section": "ARMY CONSTRUCTION & LIST BUILDING — 2,000-Point Matched Play — Revised Draft v9"
  },
  "description": "Machine-readable constants and legality rules for standard 2,000-point matched play. Army composition is limited by Points, fifteen Recruitment Slots, at least one Headquarters, and Unique restrictions. Faction and Doctrine Commands remain in their dedicated files.",
  "slotTypes": [
    {
      "code": "H",
      "name": "Headquarters",
      "eligibleUnits": "Generic Captain with Heroic Commission (a Hero), eligible Hero Wizard, faction Captains and named Leaders."
    },
    {
      "code": "C",
      "name": "Core",
      "eligibleUnits": "Generic Line Infantry, or any faction-specific Unit designated Core."
    },
    {
      "code": "E",
      "name": "Elite",
      "eligibleUnits": "Generic Elite Infantry, generic Elite Wizard and the generic Captain; faction Elite Units, including eligible Elite Wizards and Supports."
    },
    {
      "code": "R",
      "name": "Ranged",
      "eligibleUnits": "Generic Ranged Infantry, or eligible faction Ranged Infantry, including faction Ranged Core."
    },
    {
      "code": "V",
      "name": "Vanguard",
      "eligibleUnits": "Generic Cavalry; faction Cavalry, Mobile, Infiltrator, and designated Vanguard Units."
    },
    {
      "code": "S",
      "name": "Specialist",
      "eligibleUnits": "Generic non-Elite Support; faction Support or Wizard, including those with the Elite tag."
    },
    {
      "code": "A",
      "name": "Asset",
      "eligibleUnits": "Generic Artillery; faction Artillery, Vehicles, War Machines, and designated Large Assets."
    }
  ],
  "standardArmy": {
    "maxPoints": 2000,
    "totalRecruitmentSlots": 15,
    "factionCount": 1,
    "doctrineCount": 2,
    "doctrinesMustBeDistinct": true,
    "factionCommandsAvailable": 4,
    "factionCommandsSelected": 2,
    "doctrineCommandsAvailablePerDoctrine": 5,
    "doctrineCommandsSelectedPerDoctrine": 3,
    "totalSelectedCommands": 8,
    "commandPointsPerRound": 8,
    "minHeadquarters": 1,
    "maxNamedFactionLeaders": 1,
    "initialReserveRounding": "down"
  },
  "slotCalculation": {
    "universalFoundation": [
      "H",
      "C",
      "C"
    ],
    "breakdown": [
      {
        "source": "Universal Foundation",
        "slots": 3
      },
      {
        "source": "Faction Foundation",
        "slots": 2
      },
      {
        "source": "First Doctrine Foundation",
        "slots": 1
      },
      {
        "source": "Second Doctrine Foundation",
        "slots": 1
      },
      {
        "source": "Two selected Faction Commands",
        "slots": 2
      },
      {
        "source": "Three selected Commands from the first Doctrine",
        "slots": 3
      },
      {
        "source": "Three selected Commands from the second Doctrine",
        "slots": 3
      }
    ],
    "notes": [
      "Slots of the same type are interchangeable regardless of source.",
      "Slots may be left empty; unused slots grant no Points and cannot be exchanged for other categories.",
      "A Unit occupies exactly one compatible slot, even if eligible for several categories.",
      "A Command grants its slot as soon as it is selected, whether or not it is used in battle.",
      "Composition is restricted by Points, fifteen Recruitment Slots, one Headquarters, and Unique profile status. No extra minimum Core, Hero cap, or Large Asset cap."
    ]
  },
  "legalityRules": [
    {
      "id": "one-faction",
      "rule": "Exactly one Faction is selected."
    },
    {
      "id": "two-distinct-doctrines",
      "rule": "Exactly two distinct Non-Faction Doctrines are selected. Any Faction may choose any two of the sixteen."
    },
    {
      "id": "faction-commands",
      "rule": "Exactly two of the Faction's four Commands are selected."
    },
    {
      "id": "doctrine-commands",
      "rule": "Exactly three of five Commands are selected from each chosen Doctrine."
    },
    {
      "id": "slot-assignment",
      "rule": "Every purchased Unit occupies exactly one compatible, otherwise unoccupied Recruitment Slot; the assignment is recorded on the list."
    },
    {
      "id": "min-hq",
      "rule": "At least one purchased Headquarters Unit (may be non-Hero)."
    },
    {
      "id": "max-leaders",
      "rule": "No more than one named Faction Leader; all explicitly Unique named profiles are limited to one copy. No additional general Hero cap applies."
    },
    {
      "id": "unique-units",
      "rule": "A Unit with the Unique tag may be purchased only once per named profile in an army. Named Faction Leaders are Unique; ordinary Units may be repeated."
    },
    {
      "id": "points-cap",
      "rule": "Total Points (base + equipment + additional Models + upgrades) must not exceed the Points limit."
    },
    {
      "id": "reserves-count",
      "rule": "Units in Reserve count toward Points and occupy normal Recruitment Slots. Starting Reserve count is half the purchased Units rounded down; at least one Headquarters deploys normally."
    }
  ],
  "unitCostFormula": "Base Cost + Equipment + Additional Models + Other Upgrades",
  "doubleFormation": {
    "appliesTo": "Faction-specific Core Units only (not generic Line Infantry), unless the Unit profile prohibits it.",
    "modelMultiplier": 2,
    "pointsMultiplier": 2,
    "maxPerUnit": 1,
    "notes": "Doubles starting Model count and the standard formation's total Points, including selected packages and fixed-price Unit-wide upgrades. Still one Unit, one slot, one Core Unit. Ranked keywords are not doubled. Non-Cavalry, non-Elite faction Core Double Formations gain Horde, which retains objective eligibility down to one surviving Model; objective control still counts as one Unit."
  },
