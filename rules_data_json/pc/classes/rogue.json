  "id": "rogue",
  "name": "Rogue",
  "role": "Mobility, precision, exploiting weaknesses",
  "tags": ["Mobile"],
  "stats": { "move": "4\"", "wounds": 4, "armor": "6+", "evade": "5+", "ward": null },
  "classAbility": {
    "name": "Exploit Opening",
    "timing": "Passive",
    "effect": "When this Character makes a Weapon Attack, generate 1 additional normal Hit for each Surge generated by that Attack roll. These Hits do not add Attack dice or generate further Surges. They are subject to Armor, Evade, and Ward saves as normal."
  },
  "subclasses": [
