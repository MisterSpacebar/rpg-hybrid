      "signatureAbility": {
        "name": "Ambush",
        "cost": "1 CP",
        "timing": "Assault",
        "effect": "When making a Weapon Attack or Charge from Concealed this Phase, that Attack gains Attacks +2 or Impact +2, whichever applies."
      },
      "assaultPhaseWeapons": {
        "label": "Optional Weapons",
        "options": [
          { "name": "Throwing Knives", "profile": { "range": "6\"", "attacks": 3, "hit": "5+", "damage": 1, "damageTypes": ["Physical"], "keywords": [] }, "points": 5 },
          { "name": "Crossbow", "profile": { "range": "8\"", "attacks": 3, "hit": "5+", "damage": 1, "damageTypes": ["Physical"], "keywords": ["Heavy"] }, "points": 10 }
        ]
