    {
      "id": "bard",
      "name": "Bard",
      "description": "Bards support allies through encouragement, performance, improvisation, and battlefield coordination. Their support improves ordinary Skill Checks and the reliability of allied Weapon Attacks rather than creating equipment enchantments.",
      "additionalTags": ["Support"],
      "signatureAbility": {
        "name": "Inspire",
        "cost": "1 CP",
        "timing": "Movement",
        "effect": [
          "Choose another friendly Unit within Short. That Unit gains one of the following benefits:",
          "+1D6 on its next Skill Check this Round.",
          "Choose one Tag possessed by an enemy Unit on the battlefield. The friendly Unit gains Anti-[Chosen Tag] X for its next Weapon or Spell Attack this Round, where X equals half the Bard's Spirit, rounded up.",
          "The chosen benefit is consumed when its eligible roll resolves. The benefit expires if unused at the end of the Round."
        ]
      },
