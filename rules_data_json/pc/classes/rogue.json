        "chooseCount": 1,
        "options": [
          { "name": "Shortbow", "standard": true, "profile": { "range": "6\"", "attacks": 4, "hit": "6+", "damage": 1, "damageTypes": ["Physical"], "keywords": [] }, "points": 5 },
