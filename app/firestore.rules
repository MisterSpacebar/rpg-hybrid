rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A player's profile: only they can read or change it.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40;
      allow delete: if false;

      // Saved army lists are private to their owner.
      match /armies/{armyId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.army is map
          && request.resource.data.army.units is list
          && request.resource.data.army.units.size() <= 60;
      }

      // Saved characters are private to their owner.
      match /characters/{characterId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.character is map
          && request.resource.data.character.talents is map
          && request.resource.data.character.gear is list
          && request.resource.data.character.gear.size() <= 60;
      }
    }


    // Campaigns are shared with accepted members. Only the GM changes progression or membership.
    match /campaigns/{campaignId} {
      function member() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }
      function gm() {
        return signedIn() && request.auth.uid == resource.data.gmUid;
      }
      function memberOfCampaign() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.memberUids;
      }
      function gmOfCampaign() {
        return signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmUid;
      }
      allow get, list: if member();
      allow create: if signedIn()
        && request.resource.data.gmUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.xpTotal == 0
        && request.resource.data.goldBalance == 0
        && request.resource.data.act == 1
        && request.resource.data.turn == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.format in ['local', 'standard', 'long', 'grand'];
      function purchased(id) {
        return getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/marketPurchases/$(id)).data;
      }
      function offered(id) {
        return get(/databases/$(database)/documents/campaigns/$(campaignId)/marketOffers/$(id)).data;
      }
      function offerForPurchase(id) {
        let purchase = purchased(id);
        return offered(purchase.offerId);
      }
      function validMemberPurchase() {
        let pId = request.resource.data.get('lastPurchaseId', '');
        let offerId = request.resource.data.get('lastPurchaseOfferId', '');
        let p = purchased(pId);
        let o = offered(offerId);
        let l = getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/goldLedger/$(pId)).data;
        return member()
          && request.auth.uid != resource.data.gmUid
          && pId is string && pId.size() > 0
          && offerId is string && offerId.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'goldBalance', 'lastPurchaseId', 'lastPurchaseOfferId', 'lastPurchaseUid', 'updatedAt'
          ])
          && request.resource.data.lastPurchaseUid == request.auth.uid
          && p.ownerUid == request.auth.uid
          && p.createdAt == request.time
          && l.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && p.offerId == offerId
          && p.price == o.price
          && o.enabled == true
          && p.balanceAfter == request.resource.data.goldBalance
          && resource.data.get('goldBalance', 0) >= p.price
          && request.resource.data.goldBalance == resource.data.get('goldBalance', 0) - p.price
          && l.purchaseId == pId && l.actorUid == request.auth.uid
          && l.delta == -p.price && l.balanceAfter == p.balanceAfter;
      }
      allow update: if (gm()
        && request.resource.data.gmUid == resource.data.gmUid
        && request.resource.data.memberUids is list
        && request.resource.data.gmUid in request.resource.data.memberUids
        && request.resource.data.xpTotal is int
        && request.resource.data.xpTotal >= resource.data.xpTotal
        && request.resource.data.xpTotal <= 250
        && request.resource.data.get('goldBalance', 0) is int
        && request.resource.data.get('goldBalance', 0) >= 0
        && request.resource.data.act is int && request.resource.data.act >= 1 && request.resource.data.act <= 4
        && request.resource.data.turn is int && request.resource.data.turn >= 1
        && request.resource.data.format == resource.data.format
        && (request.resource.data.patronFactionId == null || request.resource.data.patronFactionId is string))
        || validMemberPurchase();
      allow delete: if gm();

      match /joinRequests/{uid} {
        allow create: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40;
        allow get: if isOwner(uid) || gmOfCampaign();
        allow list: if gmOfCampaign();
        allow delete: if gmOfCampaign();
        allow update: if false;
      }

      match /heroes/{uid} {
        allow get, list: if memberOfCampaign();
        allow create: if isOwner(uid) && memberOfCampaign()
          && request.resource.data.ownerUid == uid
          && request.resource.data.sheet is map
          && request.resource.data.sheet.talents is map
          && request.resource.data.sheet.gear is list
          && request.resource.data.sheet.gear.size() <= 60
          && request.resource.data.sheet.xpEarned == null;
        allow update: if isOwner(uid) && memberOfCampaign()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheet', 'updatedAt'])
          && request.resource.data.sheet is map
          && request.resource.data.sheet.talents is map
          && request.resource.data.sheet.gear is list
          && request.resource.data.sheet.gear.size() <= 60
          && request.resource.data.sheet.xpEarned == null;
        allow delete: if (isOwner(uid) && memberOfCampaign()) || gmOfCampaign();
      }

      // The GM controls what is in the open market and its published price.
      // PCs can buy enabled, prepriced offers without requesting per-purchase approval.
      match /marketOffers/{offerId} {
        allow get, list: if memberOfCampaign();
        allow create: if gmOfCampaign()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.kind in ['equipment', 'unit', 'craft']
          && request.resource.data.enabled == true
          && request.resource.data.createdAt == request.time
          && request.resource.data.price is int
          && request.resource.data.price >= 1
          && request.resource.data.price <= 1000
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && (request.resource.data.kind == 'unit'
            ? request.resource.data.config is map
            : request.resource.data.item is map);
        allow update: if gmOfCampaign()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled'])
          && request.resource.data.enabled is bool;
        allow delete: if gmOfCampaign();
      }

      match /marketPurchases/{purchaseId} {
        allow get, list: if memberOfCampaign();
        allow create: if memberOfCampaign()
          && request.auth.uid != get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmUid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.kind in ['equipment', 'unit', 'craft']
          && request.resource.data.price is int
          && request.resource.data.price > 0
          && request.resource.data.status == 'completed'
          && request.resource.data.createdAt == request.time
          && request.resource.data.balanceAfter is int
          && request.resource.data.balanceAfter >= 0
          && request.resource.data.keys().hasOnly([
            'offerId','ownerUid','kind','price','balanceAfter','status','createdAt','crafting'
          ])
          && (request.resource.data.kind != 'craft' || (
            request.resource.data.crafting is map
            && request.resource.data.crafting.difficulty == offered(request.resource.data.offerId).difficulty
            && request.resource.data.crafting.successes is int
            && request.resource.data.crafting.successes >= 0
            && request.resource.data.crafting.successes <= 6
            && request.resource.data.crafting.surges is int
            && request.resource.data.crafting.surges >= 0
            && request.resource.data.crafting.surges <= 3
            && request.resource.data.crafting.blunders is int
            && request.resource.data.crafting.blunders >= 0
            && request.resource.data.crafting.blunders <= 3
            && request.resource.data.crafting.success ==
              (request.resource.data.crafting.successes >= offered(request.resource.data.offerId).difficulty)
            && request.resource.data.crafting.qualities ==
              (request.resource.data.crafting.success
                ? request.resource.data.crafting.successes - offered(request.resource.data.offerId).difficulty + request.resource.data.crafting.surges
                : 0)
            && request.resource.data.crafting.flaws ==
              (request.resource.data.crafting.success ? request.resource.data.crafting.blunders : 0)
          ))
          && request.resource.data.offerId is string
          && get(/databases/$(database)/documents/campaigns/$(campaignId)/marketOffers/$(request.resource.data.offerId)).data.enabled == true
          && get(/databases/$(database)/documents/campaigns/$(campaignId)/marketOffers/$(request.resource.data.offerId)).data.kind == request.resource.data.kind
          && get(/databases/$(database)/documents/campaigns/$(campaignId)/marketOffers/$(request.resource.data.offerId)).data.price == request.resource.data.price
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.lastPurchaseId == purchaseId
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.lastPurchaseOfferId == request.resource.data.offerId
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.lastPurchaseUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.goldBalance == request.resource.data.balanceAfter;
        allow update, delete: if false;
      }

      // Player requests never grant items or spend Company Gold directly.
      match /acquisitionRequests/{requestId} {
        allow get, list: if memberOfCampaign();
        allow create: if memberOfCampaign()
          && request.auth.uid != get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmUid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.kind in ['equipment', 'craft', 'recruit', 'flex']
          && request.resource.data.status == 'pending'
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.keys().hasOnly([
            'kind', 'ownerUid', 'status', 'note', 'createdAt',
            'item', 'check', 'materials', 'config', 'factionId', 'slot'
          ]);
        allow update: if gmOfCampaign()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.kind == resource.data.kind;
        allow delete: if gmOfCampaign();
      }

      // Immutable audit trail: treasury movements and approved purchases
      // are written by the GM, never by a PC.
      match /goldLedger/{entryId} {
        allow get, list: if memberOfCampaign();
        allow create: if (gmOfCampaign() || (
          memberOfCampaign()
          && request.resource.data.kind == 'market'
          && request.resource.data.purchaseId == entryId
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/marketPurchases/$(entryId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/marketPurchases/$(entryId)).data.price == -request.resource.data.delta
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/marketPurchases/$(entryId)).data.balanceAfter == request.resource.data.balanceAfter
          ))
          && request.resource.data.delta is int
          && request.resource.data.balanceAfter is int
          && request.resource.data.balanceAfter >= 0
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.reason is string;
        allow update, delete: if false;
      }

      // The company owns permanent inventory; players only select items when deploying.
      match /inventory/{itemId} {
        allow get, list: if memberOfCampaign();
        allow create: if (gmOfCampaign()
          && request.resource.data.kind in ['unit', 'equipment']
          && (request.resource.data.kind == 'unit'
            ? request.resource.data.config is map
            : request.resource.data.item is map))
          || (
            memberOfCampaign()
            && request.resource.data.purchaseId == itemId
            && purchased(itemId).ownerUid == request.auth.uid
            && purchased(itemId).status == 'completed'
            && request.resource.data.createdAt == request.time
            && (
              (request.resource.data.kind == 'unit'
                && purchased(itemId).kind == 'unit'
                && request.resource.data.keys().hasOnly([
                  'kind','config','factionId','purchaseId','createdAt'
                ])
                && request.resource.data.config == offerForPurchase(itemId).config
                && request.resource.data.factionId == offerForPurchase(itemId).get('factionId', null))
              || (request.resource.data.kind == 'equipment'
                && purchased(itemId).kind in ['equipment', 'craft']
                && request.resource.data.keys().hasOnly([
                  'kind','item','ownerUid','purchaseId','createdAt','crafting'
                ])
                && request.resource.data.ownerUid == null
                && request.resource.data.item == offerForPurchase(itemId).item
                && (purchased(itemId).kind != 'craft'
                  || (purchased(itemId).crafting.success == true
                    && request.resource.data.crafting == purchased(itemId).crafting)))
            )
          );
        allow update: if gmOfCampaign()
          && request.resource.data.kind in ['unit', 'equipment']
          && (request.resource.data.kind == 'unit'
            ? request.resource.data.config is map
            : request.resource.data.item is map);
        allow delete: if gmOfCampaign();
      }

      // Slot entitlements are GM-controlled, and Doctrine choices belong to each PC.
      match /entitlements/{uid} {
        allow get, list: if memberOfCampaign();
        allow create, update: if gmOfCampaign()
          && request.resource.data.flexSlots is list
          && request.resource.data.flexSlots.size() <= 2
          && request.resource.data.grandThirdCommand is bool;
        allow delete: if gmOfCampaign();
      }
      match /detachments/{uid} {
        allow get, list: if memberOfCampaign();
        allow create: if isOwner(uid) && memberOfCampaign()
          && request.resource.data.ownerUid == uid
          && request.resource.data.commands is list
          && request.resource.data.commands.size() <= 3
          && request.resource.data.selections is list
          && request.resource.data.selections.size() <= 12;
        allow update: if isOwner(uid) && memberOfCampaign()
          && request.resource.data.ownerUid == uid
          && resource.data.ownerUid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doctrineId', 'commands', 'selections', 'updatedAt'])
          && request.resource.data.commands is list
          && request.resource.data.commands.size() <= 3
          && request.resource.data.selections is list
          && request.resource.data.selections.size() <= 12;
        allow delete: if (isOwner(uid) && memberOfCampaign()) || gmOfCampaign();
      }

      // GM-approved snapshots cannot be edited by PCs.
      match /approvedHeroes/{uid} {
        allow get, list: if memberOfCampaign();
        allow create, update: if gmOfCampaign()
          && request.resource.data.ownerUid == uid
          && request.resource.data.sheet is map;
        allow delete: if gmOfCampaign();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
