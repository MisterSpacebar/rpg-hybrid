rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A player's profile: only they can read or change it.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40;
      allow delete: if false;

      // Saved army lists are private to their owner.
      match /armies/{armyId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.army is map
          && request.resource.data.army.units is list
          && request.resource.data.army.units.size() <= 60;
      }

      // Saved characters are private to their owner.
      match /characters/{characterId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.character is map
          && request.resource.data.character.talents is map
          && request.resource.data.character.gear is list
          && request.resource.data.character.gear.size() <= 60;
      }
    }


    // Campaigns are shared with accepted members. Only the GM changes progression or membership.
    match /campaigns/{campaignId} {
      function member() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }
      function gm() {
        return signedIn() && request.auth.uid == resource.data.gmUid;
      }
      function memberOfCampaign() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.memberUids;
      }
      function gmOfCampaign() {
        return signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmUid;
      }
      allow get, list: if member();
      allow create: if signedIn()
        && request.resource.data.gmUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.xpTotal == 0
        && request.resource.data.goldBalance == 0
        && request.resource.data.act == 1
        && request.resource.data.turn == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.format in ['local', 'standard', 'long', 'grand'];
      function purchased(id) {
        return getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/marketPurchases/$(id)).data;
      }
      function offered(id) {
        return get(/databases/$(database)/documents/campaigns/$(campaignId)/marketOffers/$(id)).data;
      }
      function offerForPurchase(id) {
        let purchase = purchased(id);
        return offered(purchase.offerId);
      }
      function validMemberPurchase() {
        let pId = request.resource.data.get('lastPurchaseId', '');
        let offerId = request.resource.data.get('lastPurchaseOfferId', '');
        let p = purchased(pId);
        let o = offered(offerId);
        let l = getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/goldLedger/$(pId)).data;
        return member()
          && request.auth.uid != resource.data.gmUid
          && pId is string && pId.size() > 0
          && offerId is string && offerId.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'goldBalance', 'lastPurchaseId', 'lastPurchaseOfferId', 'lastPurchaseUid', 'updatedAt'
          ])
          && request.resource.data.lastPurchaseUid == request.auth.uid
          && p.ownerUid == request.auth.uid
          && p.createdAt == request.time
          && l.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && p.offerId == offerId
          && p.price == o.price
          && o.enabled == true
          && p.balanceAfter == request.resource.data.goldBalance
          && resource.data.get('goldBalance', 0) >= p.price
          && request.resource.data.goldBalance == resource.data.get('goldBalance', 0) - p.price
          && l.purchaseId == pId && l.actorUid == request.auth.uid
          && l.delta == -p.price && l.balanceAfter == p.balanceAfter;
      }
      allow update: if (gm()
        && request.resource.data.gmUid == resource.data.gmUid
        && request.resource.data.memberUids is list
        && request.resource.data.gmUid in request.resource.data.memberUids
        && request.resource.data.xpTotal is int
        && request.resource.data.xpTotal >= resource.data.xpTotal
        && request.resource.data.xpTotal <= 250
        && request.resource.data.get('goldBalance', 0) is int
        && request.resource.data.get('goldBalance', 0) >= 0
        && request.resource.data.act is int && request.resource.data.act >= 1 && request.resource.data.act <= 4
        && request.resource.data.turn is int && request.resource.data.turn >= 1
        && request.resource.data.format == resource.data.format
        && (request.resource.data.patronFactionId == null || request.resource.data.patronFactionId is string))
        || validMemberPurchase();
      allow delete: if gm();

      match /joinRequests/{uid} {
        allow create: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40;
        allow get: if isOwner(uid) || gmOfCampaign();
        allow list: if gmOfCampaign();
        allow delete: if gmOfCampaign();
        allow update: if false;
      }

      // A saved Talent entry is committed at its tier/index, including its
      // specialization choices. New XP may append further entries, but PCs
      // cannot remove/reorder/replace saved entries without an explicit future
      // Retrain transaction. Applied to every PC draft update, not just UI.
      function savedTalentPrefix(before, after) {
        return before is list && after is list
          && after.size() >= before.size()
          && (before.size() < 1 || after[0] == before[0])
          && (before.size() < 2 || after[1] == before[1])
          && (before.size() < 3 || after[2] == before[2])
          && (before.size() < 4 || after[3] == before[3])
          && (before.size() < 5 || after[4] == before[4])
          && (before.size() < 6 || after[5] == before[5]);
      }
      function keepsSavedTalents() {
        let prior = resource.data.sheet.talents;
        let next = request.resource.data.sheet.talents;
        return savedTalentPrefix(prior['1'], next['1'])
          && savedTalentPrefix(prior['2'], next['2'])
          && savedTalentPrefix(prior['3'], next['3'])
          && savedTalentPrefix(prior['4'], next['4'])
          && savedTalentPrefix(prior['5'], next['5']);
      }

      function authorizedRetrainingApply(uid) {
        let requestId = request.resource.data.get('lastRetrainingId', '');
        let before = get(/databases/$(database)/documents/campaigns/$(campaignId)/retrainingRequests/$(requestId)).data;
        let after = getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/retrainingRequests/$(requestId)).data;
        let campaign = get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
        return gmOfCampaign()
          && requestId is string && requestId.size() > 0
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sheet','lastRetrainingId','updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.sheet.diff(resource.data.sheet).affectedKeys().hasOnly(['talents'])
          && before.status == 'approved'
          && after.status == 'applied'
          && after.appliedAt == request.time
          && before.ownerUid == uid
          && after.ownerUid == uid
          && before.originalTalents == resource.data.sheet.talents
          && before.proposedTalents == request.resource.data.sheet.talents
          && before.act is int && before.turn is int
          && (campaign.act != before.act || campaign.turn != before.turn)
          && campaign.retrainOrderUsed == before.orderId;
      }

      match /heroes/{uid} {
        allow get, list: if memberOfCampaign();
        allow create: if isOwner(uid) && memberOfCampaign()
          && request.resource.data.ownerUid == uid
          && request.resource.data.sheet is map
          && request.resource.data.sheet.talents is map
          && request.resource.data.sheet.gear is list
          && request.resource.data.sheet.gear.size() <= 60
          && request.resource.data.sheet.xpEarned == null;
        allow update: if (isOwner(uid) && memberOfCampaign()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheet', 'updatedAt'])
          && request.resource.data.sheet is map
          && request.resource.data.sheet.talents is map
          && request.resource.data.sheet.gear is list
          && request.resource.data.sheet.gear.size() <= 60
          && request.resource.data.sheet.xpEarned == null
          && keepsSavedTalents()) || authorizedRetrainingApply(uid);
        // Prevent deleting a purchased talent build and recreating a fresh
        // character to bypass Retraining. The GM can retire/replace a Hero.
        allow delete: if gmOfCampaign() || (isOwner(uid) && memberOfCampaign()
          && resource.data.sheet.talents['1'].size() == 0
          && resource.data.sheet.talents['2'].size() == 0
          && resource.data.sheet.talents['3'].size() == 0
          && resource.data.sheet.talents['4'].size() == 0
          && resource.data.sheet.talents['5'].size() == 0);
      }

      // The GM controls what is in the open market and its published price.
      // PCs can buy enabled, prepriced offers without requesting per-purchase approval.
      // Standard offers are a fixed whitelist. Any campaign member may
      // initialize them, including PCs in existing campaigns. Nobody can alter
      // their price/profile or create arbitrary cheap equipment this way.
      function validStandardEquipment(offerId) {
        let defaults = {
          'standard-basic-dagger': ['melee', 'Dagger', 1],
          'standard-basic-shortsword': ['melee', 'Shortsword', 1],
          'standard-basic-longsword': ['melee', 'Longsword', 1],
          'standard-basic-warhammer': ['melee', 'Warhammer', 2],
          'standard-basic-shortbow': ['ranged', 'Shortbow', 1],
          'standard-basic-longbow': ['ranged', 'Longbow', 2],
          'standard-basic-musket': ['ranged', 'Musket', 3],
          'standard-basic-light-armor': ['armor', 'Light Armor', 1],
          'standard-basic-medium-armor': ['armor', 'Medium Armor', 2],
          'standard-basic-heavy-armor': ['armor', 'Heavy Armor', 3],
          'standard-basic-shield': ['shield', 'Shield', 1]
        };
        let value = defaults.get(offerId, []);
        return value.size() == 3
          && request.resource.data.keys().hasOnly([
            'kind', 'label', 'item', 'price', 'enabled',
            'standardEquipment', 'createdBy', 'createdAt'
          ])
          && request.resource.data.kind == 'equipment'
          && request.resource.data.label == value[1]
          && request.resource.data.item == { 'kind': value[0], 'name': value[1] }
          && request.resource.data.price == value[2]
          && request.resource.data.enabled == true
          && request.resource.data.standardEquipment == true;
      }

      function validStandardEnchant(offerId) {
        let defaults = {
          'standard-enchant-accurate-melee': ['minor:Accurate 1', 'melee', 2, 'Accurate 1'],
          'standard-enchant-accurate-ranged': ['minor:Accurate 1', 'ranged', 2, 'Accurate 1'],
          'standard-enchant-tough-armor': ['minor:Tough 1', 'armor', 2, 'Tough 1'],
          'standard-enchant-tough-shield': ['minor:Tough 1', 'shield', 2, 'Tough 1'],
          'standard-enchant-range-ranged': ['minor:+1" Attack Range', 'ranged', 1, '+1" Attack Range'],
          'standard-enchant-move-melee': ['minor:+1" Move while equipped', 'melee', 2, '+1" Move while equipped'],
          'standard-enchant-move-ranged': ['minor:+1" Move while equipped', 'ranged', 2, '+1" Move while equipped'],
          'standard-enchant-move-armor': ['minor:+1" Move while equipped', 'armor', 2, '+1" Move while equipped'],
          'standard-enchant-move-shield': ['minor:+1" Move while equipped', 'shield', 2, '+1" Move while equipped'],
          'standard-enchant-magic-melee': ['minor:Magic Attack keyword', 'melee', 2, 'Magic Attack keyword'],
          'standard-enchant-magic-ranged': ['minor:Magic Attack keyword', 'ranged', 2, 'Magic Attack keyword']
        };
        let value = defaults.get(offerId, []);
        return value.size() == 4
          && request.resource.data.keys().hasOnly([
            'kind', 'label', 'price', 'enabled', 'enchantKey',
            'targetKind', 'difficulty', 'check', 'standardEnchant',
            'createdBy', 'createdAt'
          ])
          && request.resource.data.kind == 'enchant'
          && request.resource.data.label == value[3]
          && request.resource.data.enchantKey == value[0]
          && request.resource.data.targetKind == value[1]
          && request.resource.data.price == value[2]
          && request.resource.data.difficulty == 2
          && request.resource.data.check == 'Mind + Mysticism'
          && request.resource.data.enabled == true
          && request.resource.data.standardEnchant == true;
      }

      function validStandardWorkshop(offerId) {
        let prices = {
          'standard-workshop-improve-melee': ['improve','melee',2,'Agility + Craft','Improve melee'],
          'standard-workshop-improve-ranged': ['improve','ranged',2,'Agility + Craft','Improve ranged'],
          'standard-workshop-improve-armor': ['improve','armor',2,'Body + Craft','Improve armor'],
          'standard-workshop-improve-shield': ['improve','shield',2,'Body + Craft','Improve shield'],
          'standard-workshop-repair-melee': ['repair','melee',1,'Body + Craft','Repair melee'],
          'standard-workshop-repair-ranged': ['repair','ranged',1,'Body + Craft','Repair ranged'],
          'standard-workshop-repair-armor': ['repair','armor',1,'Body + Craft','Repair armor'],
          'standard-workshop-repair-shield': ['repair','shield',1,'Body + Craft','Repair shield']
        };
        let value = prices.get(offerId, []);
        return value.size() == 5
          && request.resource.data.keys().hasOnly([
            'kind','label','price','enabled','targetKind','difficulty','check',
            'standardWorkshop','createdBy','createdAt'
          ])
          && request.resource.data.kind == value[0]
          && request.resource.data.targetKind == value[1]
          && request.resource.data.price == value[2]
          && request.resource.data.check == value[3]
          && request.resource.data.label == value[4]
          && request.resource.data.difficulty == 2
          && request.resource.data.enabled == true
          && request.resource.data.standardWorkshop == true;
      }
      function validWorkRow(row) {
        return row is map && row.keys().hasOnly(['id','ranks','choice'])
          && row.id in [
            'balanced','specialized','extended','reinforced','sheltering','swift',
            'deadly','precise','protective','exceptionalEdge','destructive','warded'
          ]
          && row.ranks is int && row.ranks >= 1 && row.ranks <= 3
          && (row.get('choice','') is string)
          && row.get('choice','').size() <= 40
          && (row.id != 'warded' || row.get('choice','') in ['physical','magic'])
          && (row.id != 'specialized' || row.get('choice','').size() > 0);
      }
      function workRowCost(row, surge) {
        return row.id in ['precise','protective','destructive'] ? 2 * row.ranks :
          row.id == 'exceptionalEdge' && surge == 1 ? row.ranks - 1 : row.ranks;
      }
      function validWorkshopReceipt(purchase, purchaseId) {
        let work = purchase.workshop;
        let plan = work.plan;
        let roll = purchase.crafting;
        let spent = (plan.size() > 0 ? workRowCost(plan[0],roll.surges) : 0)
          + (plan.size() > 1 ? workRowCost(plan[1],roll.surges) : 0)
          + (plan.size() > 2 ? workRowCost(plan[2],roll.surges) : 0);
        return work is map
          && work.keys().hasOnly(['kind','plan','repair','flaw','purchaseId'])
          && work.kind == purchase.kind
          && work.purchaseId == purchaseId
          && work.plan is list && work.plan.size() <= 3
          && (plan.size() < 1 || validWorkRow(plan[0]))
          && (plan.size() < 2 || validWorkRow(plan[1]))
          && (plan.size() < 3 || validWorkRow(plan[2]))
          && (plan.size() < 2 || plan[0].id != plan[1].id)
          && (plan.size() < 3 || (plan[0].id != plan[2].id && plan[1].id != plan[2].id))
          && spent <= roll.qualities
          && (!roll.success || work.get('repair',null) == null ||
            (purchase.kind == 'repair' && work.repair is string))
          && (roll.success || (plan.size() == 0 && work.get('repair',null) == null))
          && (purchase.kind != 'repair' || plan.size() == 0)
          && (purchase.kind == 'repair' || work.get('repair',null) == null)
          && (work.get('flaw',null) == null || work.flaw in [
            'attacks','hit','damage','range','armor','move','accurate','damaged',
            'balanced','specialized','extended','reinforced','sheltering','swift',
            'deadly','precise','protective','exceptionalEdge','destructive','warded'
          ])
          && (!roll.blunders || (purchase.kind == 'craft' && !roll.success)
            || work.get('flaw',null) is string)
          && (roll.blunders > 0 || work.get('flaw',null) == null)
          && (purchase.kind != 'repair' || !roll.success || work.get('repair',null) is string);
      }

      match /marketOffers/{offerId} {
        allow get, list: if memberOfCampaign();
        allow create: if (gmOfCampaign() || (
          memberOfCampaign()
          && (validStandardEquipment(offerId) || validStandardEnchant(offerId) || validStandardWorkshop(offerId))
        ))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.kind in ['equipment', 'unit', 'craft', 'enchant', 'improve', 'repair']
          && (request.resource.data.kind != 'enchant' || (
            request.resource.data.enchantKey is string
            && request.resource.data.enchantKey.matches('^minor:.*')
            && request.resource.data.targetKind in ['melee', 'ranged', 'armor', 'shield']
            && request.resource.data.difficulty is int
            && request.resource.data.difficulty >= 2
            && request.resource.data.difficulty <= 5
          ))
          && request.resource.data.enabled == true
          && request.resource.data.createdAt == request.time
          && request.resource.data.price is int
          && request.resource.data.price >= 1
          && request.resource.data.price <= 1000
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && (request.resource.data.kind == 'unit'
            ? request.resource.data.config is map
            : request.resource.data.kind in ['enchant','improve','repair'] || request.resource.data.item is map);
        allow update: if gmOfCampaign()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled'])
          && request.resource.data.enabled is bool;
        allow delete: if gmOfCampaign();
      }

      match /marketPurchases/{purchaseId} {
        allow get, list: if memberOfCampaign();
        allow create: if memberOfCampaign()
          && request.auth.uid != get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmUid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.kind in ['equipment', 'unit', 'craft', 'enchant', 'improve', 'repair']
          && request.resource.data.price is int
          && request.resource.data.price > 0
          && request.resource.data.status == 'completed'
          && request.resource.data.createdAt == request.time
          && request.resource.data.balanceAfter is int
          && request.resource.data.balanceAfter >= 0
          && request.resource.data.keys().hasOnly([
            'offerId','ownerUid','kind','price','balanceAfter','status','createdAt','crafting','targetItemId','workshop'
          ])
          && (request.resource.data.kind != 'enchant' || (
            request.resource.data.targetItemId is string
            && offered(request.resource.data.offerId).enchantKey.matches('^minor:.*')
            && get(/databases/$(database)/documents/campaigns/$(campaignId)/inventory/$(request.resource.data.targetItemId)).data.kind == 'equipment'
            && get(/databases/$(database)/documents/campaigns/$(campaignId)/inventory/$(request.resource.data.targetItemId)).data.item.kind == offered(request.resource.data.offerId).targetKind
            && (request.resource.data.get('workshop',null) != null ||
              !request.resource.data.crafting.success ||
              getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/inventory/$(request.resource.data.targetItemId)).data.lastEnhancementId == purchaseId)
          ))
          && (request.resource.data.kind in ['improve','repair'] ? (
            request.resource.data.targetItemId is string
            && request.resource.data.workshop is map
            && get(/databases/$(database)/documents/campaigns/$(campaignId)/inventory/$(request.resource.data.targetItemId)).data.kind == 'equipment'
            && get(/databases/$(database)/documents/campaigns/$(campaignId)/inventory/$(request.resource.data.targetItemId)).data.item.kind == offered(request.resource.data.offerId).targetKind
          ) : true)
          && (request.resource.data.get('workshop',null) == null ||
            validWorkshopReceipt(request.resource.data,purchaseId))
          && (!(request.resource.data.kind in ['craft', 'enchant','improve','repair']) || (
            request.resource.data.crafting is map
            && request.resource.data.crafting.difficulty == offered(request.resource.data.offerId).difficulty
            && request.resource.data.crafting.successes is int
            && request.resource.data.crafting.successes >= 0
            && request.resource.data.crafting.successes <= 6
            && request.resource.data.crafting.surges is int
            && request.resource.data.crafting.surges >= 0
            && request.resource.data.crafting.surges <= 1
            && request.resource.data.crafting.blunders is int
            && request.resource.data.crafting.blunders >= 0
            && request.resource.data.crafting.blunders <= 1
            && request.resource.data.crafting.success ==
              (request.resource.data.crafting.successes >= offered(request.resource.data.offerId).difficulty)
            && request.resource.data.crafting.qualities ==
              (request.resource.data.crafting.success
                ? request.resource.data.crafting.successes - offered(request.resource.data.offerId).difficulty
                : 0)
            && request.resource.data.crafting.flaws ==
              (request.resource.data.crafting.success ? request.resource.data.crafting.blunders : 0)
          ))
          && request.resource.data.offerId is string
          && get(/databases/$(database)/documents/campaigns/$(campaignId)/marketOffers/$(request.resource.data.offerId)).data.enabled == true
          && get(/databases/$(database)/documents/campaigns/$(campaignId)/marketOffers/$(request.resource.data.offerId)).data.kind == request.resource.data.kind
          && get(/databases/$(database)/documents/campaigns/$(campaignId)/marketOffers/$(request.resource.data.offerId)).data.price == request.resource.data.price
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.lastPurchaseId == purchaseId
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.lastPurchaseOfferId == request.resource.data.offerId
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.lastPurchaseUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.goldBalance == request.resource.data.balanceAfter;
        allow update, delete: if false;
      }

      // Player requests never grant items or spend Company Gold directly.
      match /acquisitionRequests/{requestId} {
        allow get, list: if memberOfCampaign();
        allow create: if memberOfCampaign()
          && request.auth.uid != get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmUid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.kind in ['equipment', 'craft', 'recruit', 'flex']
          && request.resource.data.status == 'pending'
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.keys().hasOnly([
            'kind', 'ownerUid', 'status', 'note', 'createdAt',
            'item', 'check', 'materials', 'config', 'factionId', 'slot'
          ]);
        allow update: if gmOfCampaign()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.kind == resource.data.kind;
        allow delete: if gmOfCampaign();
      }

      match /retrainingRequests/{requestId} {
        allow get, list: if memberOfCampaign();
        // A PC may propose one replacement for the GM-declared Develop Order.
        // Only the GM can confirm and charge Gold; PCs cannot write hero Talents.
        allow create: if memberOfCampaign()
          && request.auth.uid != get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmUid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'requested'
          && request.resource.data.orderId == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.activeDevelopOrder
          && request.resource.data.orderId != get(/databases/$(database)/documents/campaigns/$(campaignId)).data.get('retrainOrderUsed', '')
          && request.resource.data.act == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.act
          && request.resource.data.turn == get(/databases/$(database)/documents/campaigns/$(campaignId)).data.turn
          && requestId == 'retrain-' + request.auth.uid + '-' + request.resource.data.orderId
          && request.resource.data.tier is int
          && request.resource.data.tier >= 1
          && request.resource.data.tier <= 5
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index <= 5
          && request.resource.data.newTalent is map
          && request.resource.data.newTalent.id is string
          && request.resource.data.keys().hasOnly([
            'ownerUid','orderId','act','turn','status','tier','index','newTalent','createdAt'
          ])
          && request.resource.data.createdAt == request.time;
        allow update: if gmOfCampaign()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.tier == resource.data.tier
          && request.resource.data.index == resource.data.index
          && request.resource.data.newTalent == resource.data.newTalent
          && request.resource.data.act == resource.data.act
          && request.resource.data.turn == resource.data.turn
          && (
            (resource.data.status == 'requested'
              && request.resource.data.status in ['approved','declined']
              && request.resource.data.resolvedAt == request.time)
            || (resource.data.status == 'approved'
              && request.resource.data.status == 'applied'
              && request.resource.data.appliedAt == request.time
              && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/heroes/$(resource.data.ownerUid)).data.lastRetrainingId == requestId
              && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/heroes/$(resource.data.ownerUid)).data.sheet.talents == resource.data.proposedTalents)
          );
        allow delete: if gmOfCampaign();
      }

      // Immutable audit trail: treasury movements and approved purchases
      // are written by the GM, never by a PC.
      match /goldLedger/{entryId} {
        allow get, list: if memberOfCampaign();
        allow create: if (gmOfCampaign() || (
          memberOfCampaign()
          && request.resource.data.kind == 'market'
          && request.resource.data.purchaseId == entryId
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/marketPurchases/$(entryId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/marketPurchases/$(entryId)).data.price == -request.resource.data.delta
          && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/marketPurchases/$(entryId)).data.balanceAfter == request.resource.data.balanceAfter
          ))
          && request.resource.data.delta is int
          && request.resource.data.balanceAfter is int
          && request.resource.data.balanceAfter >= 0
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.reason is string;
        allow update, delete: if false;
      }

      function validWorkshopAppend(itemId) {
        let receiptId = request.resource.data.get('lastWorkshopId','');
        let purchase = purchased(receiptId);
        let before = resource.data.get('workshopEvents',[]);
        let after = request.resource.data.get('workshopEvents',[]);
        let oldEnchants = resource.data.get('enchants',[]);
        let nextEnchants = request.resource.data.get('enchants',[]);
        return memberOfCampaign()
          && resource.data.kind == 'equipment'
          && (resource.data.get('ownerUid',null) == null ||
            resource.data.ownerUid == request.auth.uid)
          && receiptId is string && receiptId.size() > 0
          && purchase.kind in ['enchant','improve','repair']
          && purchase.targetItemId == itemId
          && purchase.ownerUid == request.auth.uid
          && purchase.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'workshopEvents','lastWorkshopId','updatedAt','enchants','lastEnhancementId'
          ])
          && after is list && after.size() == before.size() + 1
          && after.size() <= 8
          && (before.size() < 1 || after[0] == before[0])
          && (before.size() < 2 || after[1] == before[1])
          && (before.size() < 3 || after[2] == before[2])
          && (before.size() < 4 || after[3] == before[3])
          && (before.size() < 5 || after[4] == before[4])
          && (before.size() < 6 || after[5] == before[5])
          && (before.size() < 7 || after[6] == before[6])
          && after[after.size()-1] == purchase.workshop
          && (purchase.kind == 'enchant' && purchase.crafting.success ?
            (nextEnchants is list
              && nextEnchants.size() == oldEnchants.size() + 1
              && nextEnchants.size() <= 3
              && (oldEnchants.size() < 1 || nextEnchants[0] == oldEnchants[0])
              && (oldEnchants.size() < 2 || nextEnchants[1] == oldEnchants[1])
              && nextEnchants[nextEnchants.size()-1] ==
                { 'key': offered(purchase.offerId).enchantKey }
              && request.resource.data.lastEnhancementId == receiptId)
            : (nextEnchants == oldEnchants
              && request.resource.data.get('lastEnhancementId',null) ==
                 resource.data.get('lastEnhancementId',null)));
      }

      // The company owns permanent inventory; players only select items when deploying.
      match /inventory/{itemId} {
        allow get, list: if memberOfCampaign();
        allow create: if (
          memberOfCampaign()
          && request.resource.data.kind == 'equipment'
          && request.resource.data.starterOwnerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.starterOriginal is map
          && request.resource.data.starterGearUid == request.resource.data.starterOriginal.uid
          && itemId == 'starter-' + request.auth.uid + '-' + request.resource.data.starterGearUid
          && request.resource.data.starterOriginal.get('inventoryId', null) == null
          && request.resource.data.starterOriginal in get(
            /databases/$(database)/documents/campaigns/$(campaignId)/approvedHeroes/$(request.auth.uid)
          ).data.sheet.gear
          && request.resource.data.item == {
            'kind': request.resource.data.starterOriginal.kind,
            'name': request.resource.data.starterOriginal.name
          }
          && request.resource.data.keys().hasOnly([
            'kind','item','ownerUid','starterOwnerUid',
            'starterGearUid','starterOriginal','createdAt'
          ])
          && request.resource.data.createdAt == request.time
        ) || (gmOfCampaign()
          && request.resource.data.kind in ['unit', 'equipment']
          && (request.resource.data.kind == 'unit'
            ? request.resource.data.config is map
            : request.resource.data.item is map))
          || (
            memberOfCampaign()
            && request.resource.data.purchaseId == itemId
            && purchased(itemId).ownerUid == request.auth.uid
            && purchased(itemId).status == 'completed'
            && request.resource.data.createdAt == request.time
            && (
              (request.resource.data.kind == 'unit'
                && purchased(itemId).kind == 'unit'
                && request.resource.data.keys().hasOnly([
                  'kind','config','factionId','purchaseId','createdAt'
                ])
                && request.resource.data.config == offerForPurchase(itemId).config
                && request.resource.data.factionId == offerForPurchase(itemId).get('factionId', null))
              || (request.resource.data.kind == 'equipment'
                && purchased(itemId).kind in ['equipment', 'craft']
                && request.resource.data.keys().hasOnly([
                  'kind','item','ownerUid','purchaseId','createdAt','crafting','workshopEvents','lastWorkshopId'
                ])
                && request.resource.data.ownerUid == null
                && request.resource.data.item == offerForPurchase(itemId).item
                && (purchased(itemId).kind != 'craft'
                  || (purchased(itemId).crafting.success == true
                    && request.resource.data.crafting == purchased(itemId).crafting))
                && (purchased(itemId).get('workshop',null) == null ||
                  (request.resource.data.get('workshopEvents',[]) == [purchased(itemId).workshop]
                    && request.resource.data.lastWorkshopId == itemId)))
            )
          );
        allow update: if (gmOfCampaign()
          && request.resource.data.kind in ['unit', 'equipment']
          && (request.resource.data.kind == 'unit'
            ? request.resource.data.config is map
            : request.resource.data.item is map))
          || (
            memberOfCampaign()
            && resource.data.kind == 'equipment'
            && (resource.data.get('ownerUid', null) == null || resource.data.ownerUid == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'enchants', 'lastEnhancementId', 'updatedAt'
            ])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.enchants is list
            && request.resource.data.enchants.size() <= 3
            && request.resource.data.enchants.size() == resource.data.get('enchants', []).size() + 1
            && request.resource.data.enchants[request.resource.data.enchants.size() - 1] ==
              { 'key': offerForPurchase(request.resource.data.lastEnhancementId).enchantKey }
            && (resource.data.get('enchants', []).size() < 1 ||
              request.resource.data.enchants[0] == resource.data.enchants[0])
            && (resource.data.get('enchants', []).size() < 2 ||
              request.resource.data.enchants[1] == resource.data.enchants[1])
            && !({ 'key': offerForPurchase(request.resource.data.lastEnhancementId).enchantKey } in resource.data.get('enchants', []))
            && purchased(request.resource.data.lastEnhancementId).createdAt == request.time
            && purchased(request.resource.data.lastEnhancementId).ownerUid == request.auth.uid
            && purchased(request.resource.data.lastEnhancementId).targetItemId == itemId
            && purchased(request.resource.data.lastEnhancementId).kind == 'enchant'
            && purchased(request.resource.data.lastEnhancementId).crafting.success == true
            && offerForPurchase(request.resource.data.lastEnhancementId).targetKind == resource.data.item.kind
          ) || validWorkshopAppend(itemId);
        allow delete: if gmOfCampaign();
      }

      // Slot entitlements are GM-controlled, and Doctrine choices belong to each PC.
      match /entitlements/{uid} {
        allow get, list: if memberOfCampaign();
        allow create, update: if gmOfCampaign()
          && request.resource.data.flexSlots is list
          && request.resource.data.flexSlots.size() <= 2
          && request.resource.data.grandThirdCommand is bool;
        allow delete: if gmOfCampaign();
      }
      match /detachments/{uid} {
        allow get, list: if memberOfCampaign();
        allow create: if isOwner(uid) && memberOfCampaign()
          && request.resource.data.ownerUid == uid
          && request.resource.data.commands is list
          && request.resource.data.commands.size() <= 3
          && request.resource.data.selections is list
          && request.resource.data.selections.size() <= 12;
        allow update: if isOwner(uid) && memberOfCampaign()
          && request.resource.data.ownerUid == uid
          && resource.data.ownerUid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doctrineId', 'commands', 'selections', 'updatedAt'])
          && request.resource.data.commands is list
          && request.resource.data.commands.size() <= 3
          && request.resource.data.selections is list
          && request.resource.data.selections.size() <= 12;
        allow delete: if (isOwner(uid) && memberOfCampaign()) || gmOfCampaign();
      }

      // GM-approved snapshots cannot be edited by PCs.
      match /approvedHeroes/{uid} {
        allow get, list: if memberOfCampaign();
        allow create, update: if gmOfCampaign()
          && request.resource.data.ownerUid == uid
          && request.resource.data.sheet is map;
        allow delete: if gmOfCampaign();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
